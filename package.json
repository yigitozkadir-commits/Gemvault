{
  "name": "gemvault-pro",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "735 production-grade Gemini Gem instructions, offline-first PWA + Android TWA.",
  "engines": { "node": ">=20.11.0", "pnpm": ">=9.0.0" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build && node scripts/bundle-stats.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "icons": "node scripts/generate-icons.mjs",
    "splash": "node scripts/generate-splash.mjs",
    "verify-data": "node scripts/verify-data.mjs",
    "migrate": "node scripts/migrate-from-monolith.mjs",
    "build-instructions": "node scripts/build-instructions.mjs",
    "release": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@vitest/coverage-v8": "^2.1.0",
    "commitlint": "^19.5.0",
    "eslint": "^9.12.0",
    "eslint-plugin-security": "^3.0.1",
    "happy-dom": "^15.0.0",
    "lefthook": "^1.7.0",
    "prettier": "^3.3.0",
    "sharp": "^0.33.5",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.1.0",
    "workbox-expiration": "^7.1.0",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0",
    "workbox-window": "^7.1.0"
  }
}
